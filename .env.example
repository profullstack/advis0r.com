# --- AI providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Alpaca Market Data ---
# Covers BOTH equities and crypto (/crypto/**) — crypto needs no additional key
# and no additional subscription. The crypto feed also answers unauthenticated,
# so /crypto/** still works if these are unset; equities fall back to Yahoo.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: override the data base URL (defaults to https://data.alpaca.markets)
APCA_API_DATA_URL=

# --- Database (libSQL / Turso) ---
# For a local embedded database use: file:./data/transcripts.sqlite
# For Turso use the libsql:// URL for your database and an auth token.
DATABASE_URL=file:./data/transcripts.sqlite
DATABASE_AUTH_TOKEN=

# --- SEC EDGAR ---
# The SEC requires a descriptive User-Agent with contact info on every request.
SEC_USER_AGENT="transcript-search research (you@example.com)"

# --- News discovery (PRD v3 §3.1) ---
# Optional. Keyless RSS discovery works without it; ValueSERP adds dated,
# publisher-attributed Google News results.
VALUESERP_API_KEY=

# --- Speech-to-text for audio/video sources (PRD v3 §2.2) ---
# Groq whisper-large-v3-turbo: ~$0.04 per hour of audio.
GROQ_API_KEY=

# --- Speech-to-text (PRD v3 §2.2) ---
# Preferred: word-level timestamps + speaker diarization.
ELEVENLABS_API_KEY=

# --- Transactional email for auth (PRD v3 §7) ---
# Resend is primary; Mailgun is the fallback. Without either, signup still
# works but no verification email is sent.
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Must be a domain verified in the mail provider.
MAIL_FROM=advis0r <noreply@advis0r.com>
# Public base URL used to build links in emails.
APP_URL=https://advis0r.com

# --- Credit purchases via CoinPayPortal (PRD v3 §8) ---
COINPAYPORTAL_API_KEY=
COINPAYPORTAL_BUSINESS_ID=
COINPAYPORTAL_WEBHOOK_SECRET=

# Set to 1 to block all outbound mail (also blocked automatically under test).
MAIL_DISABLED=

# --- Watchlist email digests ---
# The server sends watchlist digests itself, at the 04:00 ET pre-market open on
# trading days. Set to 0 to disable the in-process scheduler and drive it from
# cron instead (`transcripts digest send`). Requires a mail transport above.
DIGEST_SCHEDULER=
